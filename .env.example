# Salin ke .env.local lalu isi dari Supabase Dashboard > Project Settings > API.
# Jangan commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publik aplikasi, dipakai untuk tautan di email verifikasi/reset password
# dan redirect login Google. Kosongkan di lokal; otomatis memakai host request.
# Contoh produksi: https://semai.id
NEXT_PUBLIC_SITE_URL=

# Khusus server, JANGAN diawali NEXT_PUBLIC_.
# Service role key dari Supabase Dashboard > Project Settings > API.
# Dipakai untuk membuat akun karyawan dan reset PIN.
SUPABASE_SERVICE_ROLE_KEY=

# Secret untuk mengubah PIN karyawan jadi password Supabase (HMAC).
# Buat sekali dengan: openssl rand -base64 48
# Jangan diganti setelah ada karyawan aktif: semua PIN jadi tidak berlaku.
EMPLOYEE_PIN_SECRET=

# Pembayaran langganan (Midtrans Snap: VA bank + QRIS). Khusus server.
# Server key dari dashboard Midtrans > Settings > Access Keys (pakai sandbox
# untuk tes). Kosong = tombol bayar menampilkan "pembayaran online belum aktif".
# Payment Notification URL di dashboard Midtrans: https://<domain>/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Secret job harian hapus foto absen (/api/cron/hapus-foto). Khusus server.
# Buat dengan: openssl rand -base64 48 (minimal 32 karakter).
# Di Vercel: isi env CRON_SECRET; Vercel Cron otomatis mengirim
# Authorization: Bearer <CRON_SECRET>. Kosong = job menolak jalan.
CRON_SECRET=
