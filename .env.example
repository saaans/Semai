# Salin ke .env.local lalu isi dari Supabase Dashboard > Project Settings > API.
# Jangan commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publik aplikasi, dipakai untuk tautan di email verifikasi/reset password
# dan redirect login Google. Kosongkan di lokal; otomatis memakai host request.
# Contoh produksi: https://semai.id
NEXT_PUBLIC_SITE_URL=
